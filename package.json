{
  "name": "prompt-engineering",
  "version": "5.0.0",
  "description": "PromptForge \u2014 a prompt engineering studio for Claude: learn, build, test, evaluate and ship prompts and agent harnesses.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
