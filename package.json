  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "promptfoo": "^0.103.0"
  },
  "engines": {
    "node": ">=20"
  }
