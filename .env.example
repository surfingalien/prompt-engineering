# PromptForge needs ONE way to run models: a Claude key, a free-model gateway,
# or both. With neither, the studio runs in offline mode (learning path,
# builder, analyzer, library and harness export all still work).

# ── Claude ──────────────────────────────────────────────────────────────────
# Optional when a gateway is set. The key stays on the server and never
# reaches the browser. Visitors can also bring their own key in Settings.
ANTHROPIC_API_KEY=

# ── Free models via an OpenAI-compatible gateway ────────────────────────────
# Run live without any Claude key. Point this at a self-hosted gateway that
# routes to providers' free tiers using YOUR OWN free API keys:
#   OmniRoute   http://localhost:20128/v1  (docker compose --profile free up -d;
#                                           in compose use http://omniroute:20128/v1)
#   FreeLLMAPI  http://localhost:3001/v1   (github.com/tashfeenahmed/freellmapi)
# Any server speaking the OpenAI Chat Completions API works.
# LLM_GATEWAY_URL=http://localhost:20128/v1
# Bearer key the gateway issued to PromptForge (OmniRoute: Dashboard → Endpoints).
# LLM_GATEWAY_KEY=
# Label shown in the UI (default "Free gateway").
# LLM_GATEWAY_NAME=OmniRoute
# Curate the model list (comma-separated). Default: discovered from /v1/models.
# LLM_GATEWAY_MODELS=auto,groq/llama-3.3-70b-versatile,gemini/gemini-2.5-flash
# Default gateway model (default "auto" when offered).
# LLM_GATEWAY_DEFAULT_MODEL=auto
# A different, ideally stronger, model for grading and Scout verification.
# LLM_GATEWAY_JUDGE_MODEL=gemini/gemini-2.5-flash
# Daily cap on gateway requests, protecting your free quotas (default 1000; 0 = off).
# GATEWAY_DAILY_REQUEST_LIMIT=1000

# OmniRoute container secrets (only for `docker compose --profile free`).
# Generate each with: openssl rand -hex 32
# OMNIROUTE_JWT_SECRET=
# OMNIROUTE_API_KEY_SECRET=
# Leave empty to set the dashboard password in OmniRoute's first-run wizard.
# OMNIROUTE_INITIAL_PASSWORD=

# Optional: restrict which models the UI may call (comma-separated).
# Default: claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-fable-5-2
# ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# Optional: default model shown in the UI (an allowed Claude model, or a
# gateway model as gw:<id>, e.g. gw:auto). Without a Claude key the gateway
# default is used automatically.
# DEFAULT_MODEL=claude-opus-5-5

# Optional: hard cap on output tokens per request (default 16000, max 64000).
# MAX_OUTPUT_TOKENS=16000

# ── Spend protection (public deployments) ───────────────────────────────────
# Hard daily cap on spend through the shared key, in USD (default 10; 0 = off).
# Computed from token usage x model prices; resets at 00:00 UTC.
# DAILY_BUDGET_USD=10
# Where the day's spend is stored so the cap survives restarts.
# SPEND_STATE_PATH=./spend-state.json
# Optional shared password visitors enter in Settings to use the shared key.
# Visitors can always bring their own Anthropic key instead.
# ACCESS_PASSWORD=

# Optional: per-IP request limits per 15 minutes (defaults 60 / 10).
# CHAT_RATE_LIMIT=60
# SCOUT_RATE_LIMIT=10

# Behind one reverse proxy (Railway, Render, Fly) leave at 1 so rate limits key
# on the real client IP. Set to 0 when the app is exposed directly.
# TRUST_PROXY=1

# Disable the Scout's cross-model verification pass (default: enabled)
# SCOUT_VERIFY=0

# Helicone API key (optional) — routes Anthropic calls through Helicone for
# per-request cost, latency and prompt-version observability.
HELICONE_API_KEY=

# ── Open Design (optional companion service in docker-compose.yml) ──────────
# Generate with: openssl rand -hex 32
OD_API_TOKEN=
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest
OPEN_DESIGN_PORT=7456
OPEN_DESIGN_ALLOWED_ORIGINS=
OPEN_DESIGN_MEM_LIMIT=384m
NODE_OPTIONS=--max-old-space-size=192
